{
  "name": "dsh-codex-history",
  "version": "1.3.2",
  "description": "DeepSeek Harness 插件：自动读取本地 Codex 会话历史（~/.codex/sessions），让 DSH 与 Codex 无缝衔接；支持会话检索、工作要点、跨机共享目录与实时增量同步。",
  "license": "MIT",
  "author": "chameleonn4",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codex",
    "codex-history",
    "chat-history",
    "harness-plugin"
  ],
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json",
    "assets"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chameleonn4/dsh-codex-history.git"
  },
  "homepage": "https://github.com/chameleonn4/dsh-codex-history#readme",
  "bugs": {
    "url": "https://github.com/chameleonn4/dsh-codex-history/issues"
  },
  "engines": {
    "dsh": ">=0.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
